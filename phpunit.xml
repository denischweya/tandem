<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Throwaway key, committed deliberately: Sanctum tokens, signed verification URLs
             and encrypted cookies all need a real APP_KEY, and .env.example ships one blank.
             Without this pinned here, the suite fails everywhere with "No application
             encryption key has been specified" until a developer manually runs
             `artisan key:generate` - see `make setup` in the Makefile, which also covers it
             for `make api`. This key secures nothing: it is public, in version control, and
             used only against the disposable tandem_test database. -->
        <env name="APP_KEY" value="base64:3EVQEjyCqVgy50OyBXFOsjp6k55iIkj6TWRXTwtnbiw="/>
        <!-- Unpinned, this arrives from .env (locally) or `cp .env.example .env` (in CI) and
             can be true. Spec §135 / blueprint §126 require that no raw backend error reach a
             user, and APP_DEBUG is the one remaining unpinned value that changes what an HTTP
             error response *contains* - with it true, Laravel's exception handler returns the
             full stack trace and message instead of the production error shape. Any
             error-shape test in a later plan would then be authored against the debug payload
             and assert the wrong thing for production. -->
        <env name="APP_DEBUG" value="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="tandem_test"/>
        <env name="DB_USERNAME" value="tandem"/>
        <env name="DB_PASSWORD" value="tandem"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- REDIS_HOST/REDIS_PORT first, deliberately: an unpinned REDIS_CLIENT only makes
             the suite fail (self-correcting, see below); an unpinned REDIS_HOST would let
             /ready's Redis probe quietly pass against whatever Redis happens to be running
             on the machine - the same silently-wrong-green failure DB_HOST is already
             pinned to prevent. -->
        <env name="REDIS_HOST" value="127.0.0.1"/>
        <env name="REDIS_PORT" value="6379"/>
        <!-- config/database.php defaults REDIS_CLIENT to phpredis, which this project does
             not install (composer requires predis/predis instead). Unpinned, /health and
             /ready fail with a 503 the moment anyone's shell does not already export
             REDIS_CLIENT=predis. -->
        <env name="REDIS_CLIENT" value="predis"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
