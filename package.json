{
  "name": "tandem-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format-check": "prettier --check .",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run format-check && npm run test && npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tandem/shared": "github:denischweya/tandem-shared#8ed9d48",
    "@tanstack/react-query": "^5.104.1",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "server-only": "0.0.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
