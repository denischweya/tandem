{
    "openapi": "3.1.0",
    "info": {
        "title": "Tandem",
        "version": "1.0.0",
        "description": "Tandem API"
    },
    "servers": [
        {
            "url": "http://localhost:8000/api/v1",
            "description": "local"
        }
    ],
    "paths": {
        "/auth/register": {
            "post": {
                "operationId": "auth.register",
                "tags": [
                    "Register"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/auth/verify-email": {
            "post": {
                "operationId": "auth.verify-email",
                "tags": [
                    "VerifyEmail"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/VerifyEmailRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "RegisterRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 254
                    },
                    "password": {
                        "type": "string",
                        "description": "Length only, no composition rules: NIST SP 800-63B advises against them, and\nthey measurably push users toward predictable substitutions. ->uncompromised()\nis deliberately absent: it calls the Have I Been Pwned API, which would put a\nnetwork round trip inside the registration request and make CI depend on an\nexternal service. Revisit with a locally shipped breach list."
                    },
                    "display_name": {
                        "type": "string",
                        "maxLength": 80
                    },
                    "timezone": {
                        "type": "string"
                    },
                    "locale": {
                        "type": "string",
                        "maxLength": 10
                    }
                },
                "required": [
                    "email",
                    "password",
                    "display_name",
                    "timezone"
                ],
                "title": "RegisterRequest"
            },
            "UserResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "email_verified": {
                        "type": "boolean"
                    },
                    "display_name": {
                        "type": "string"
                    },
                    "timezone": {
                        "type": "string"
                    },
                    "locale": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "email",
                    "email_verified",
                    "display_name",
                    "timezone",
                    "locale"
                ],
                "title": "UserResource"
            },
            "VerifyEmailRequest": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "hash": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "hash"
                ],
                "title": "VerifyEmailRequest"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthorizationException": {
                "description": "Authorization error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}