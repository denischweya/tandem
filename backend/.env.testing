# Read by `artisan ... --env=testing` (and ONLY that - PHPUnit/Pest never read this file;
# phpunit.xml's <env> values are injected into the process before Laravel's dotenv loader
# runs, and that loader does not override an already-set variable, so the suite's pins win
# regardless of this file's existence). Its one job is to make the --env=testing flag itself
# safe: without it, Laravel falls back to .env - the DEVELOPMENT database - because no
# .env.testing existed to find. See CLAUDE.md and tests/TestCase.php for the incident this
# closes.
#
# No real secrets: APP_KEY is intentionally blank, same as .env.example.
APP_NAME=Tandem
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tandem_test
DB_USERNAME=tandem
DB_PASSWORD=tandem

# array/sync, matching the drivers phpunit.xml pins for the suite - this is the test
# environment, not the development one.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@tandem.local"
MAIL_FROM_NAME="Tandem"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
